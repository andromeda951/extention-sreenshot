{
  "manifest_version": 3,
  "name": "Coding Kids Monitor",
  "version": "0.3.0",
  "description": "Ekstensi Chrome sederhana untuk membantu tutor mengambil screenshot tab Scratch siswa.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://scratch.mit.edu/*",
    "*://*.scratch.mit.edu/*",
    "ws://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Coding Kids Monitor"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
